#leaving this blank will expect your databases.json file in the same directory as your compose.yml
AGENT_DIR=
#set to your preferred timezone
TZ=UTC
#paste in edge key generated in the portabase dashboard app
EDGE_KEY=

DATABASE_NETWORK_1=service1_net
DATABASE_NETWORK_2=service2_net
POLLING=5

AGENT_IMAGE=portabase/agent:latest

# --- Deployment Settings ---
CONTAINER_NAME=portabase-agent

# --- Deployment Settings ---
APP_ENV=production
LOG_LEVEL=info

# --- Deployment Settings ---
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

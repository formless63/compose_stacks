# DIRECTUS CONFIGURATION
# ----------------------
# Choose a tested application release/digest. Redis stays on current major version 8.
DIRECTUS_VERSION=latest
REDIS_VERSION=8-alpine

# Project Identification
# These MUST be set. Use `openssl rand -hex 16` to generate secure values.
DIRECTUS_KEY=generate_a_random_string_here
DIRECTUS_SECRET=

# The URL where this instance will be accessible
DIRECTUS_PUBLIC_URL=https://your-domain.com

# Admin User Setup
# The initial admin user created on first launch
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=

# DATABASE CONNECTION
# -------------------
# Connects to your EXISTING database
DB_CLIENT=pg
DB_HOST=10.0.0.5
DB_PORT=5432
DB_DATABASE=directus_production
DB_USER=directus_user
DB_PASSWORD=
DB_SCHEMA=public

# Connection Pooling
# Tune this based on your DB's max_connections limit
DB_POOL_MIN=2
DB_POOL_MAX=10

# STORAGE
# -------
# Local storage paths for uploads and extensions
DIRECTUS_UPLOADS_DIR=./uploads
DIRECTUS_EXTENSIONS_DIR=./extensions
REDIS_DIR=./redis

DIRECTUS_PORT=8055

# --- Deployment Settings ---
CONTAINER_NAME=directus
CACHE_CONTAINER_NAME=directus-cache

# --- Deployment Settings ---
NETWORK_NAME=directus
CACHE_ENABLED=true
CACHE_AUTO_PURGE=true
CACHE_SCHEMA=true
TELEMETRY=false
LOG_LEVEL=warn

# --- Deployment Settings ---
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

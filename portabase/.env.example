# --- App Configuration ---
HOST_PORT=8887
PROJECT_NAME=portabase-dashboard
PROJECT_URL=https://portabase.domain.com

# ⚠️ GENERATE A STRONG SECRET (e.g., openssl rand -hex 32)
# This secret is used to encrypt communications with agents.
PROJECT_SECRET=

# --- Internal Database Configuration ---
POSTGRES_DB=portabase
POSTGRES_USER=portabase
POSTGRES_PASSWORD=
POSTGRES_HOST=portabase-pg

# Override with a tested release or immutable digest.
PORTABASE_IMAGE=portabase/portabase:latest

TZ=UTC
DATA_DIR=./data
DB_DIR=./db
# Optional compose.proxy.yml overlay
PROXY_NETWORK=newt_net

# --- Deployment Settings ---
CONTAINER_NAME=portabase
DB_CONTAINER_NAME=portabase-pg

# --- Deployment Settings ---
POSTGRES_IMAGE=postgres:17-alpine
NODE_ENV=production
NETWORK_NAME=portabase_internal

# --- Deployment Settings ---
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

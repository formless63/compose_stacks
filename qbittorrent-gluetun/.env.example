# Keep image selections here when pulling repository updates.
GLUETUN_IMAGE=qmcgaw/gluetun:latest
QBIT_IMAGE=binhex/arch-qbittorrent:latest
VPN_UI_IMAGE=scuzza/gluetun-webui:latest
MANAGE_IMAGE=ghcr.io/stuffanthings/qbit_manage:latest
TZ=Etc/UTC
PUID=1000
PGID=1000
UMASK=002

# Proton paid account: generate a WireGuard key with NAT-PMP enabled.
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
PROTON_KEY=
SERVER_COUNTRIES=United States
PORT_FORWARD_ONLY=on
VPN_PORT_FORWARDING=on
GLUETUN_USER=gluetun
# Use a long alphanumeric password: it is interpolated into JSON.
GLUETUN_PASS=
QBIT_USER=admin
QBIT_PASS=

QBIT_BIND_IP=0.0.0.0
QBIT_PORT=8080
# Gluetun WebUI has no login. Change to your LAN IP only on a trusted LAN,
# or put it behind an authenticated reverse proxy.
VPN_UI_BIND_IP=127.0.0.1
VPN_UI_PORT=3009
VPN_UI_TRUST_PROXY=false
# Enable qbit_manage authentication in its UI before allowing LAN access.
MANAGE_BIND_IP=127.0.0.1
MANAGE_PORT=8185

# Empty by default. Add only specific destinations qBittorrent must reach
# outside the VPN (e.g. 192.168.1.50/32). Never overlap the VPN tunnel subnet.
FIREWALL_OUTBOUND_SUBNETS=
TUN_DEVICE=/dev/net/tun
VPN_CONFIG_DIR=./config/gluetun
QBIT_CONFIG_DIR=./config/qbittorrent
MANAGE_CONFIG_DIR=./config/qbit_manage
DOWNLOADS_DIR=./downloads
MANAGE_SCHEDULE=1440
MANAGE_STARTUP_DELAY=30
MANAGE_LOG_LEVEL=INFO
CONTROL_SERVER_LOG=on
VPN_CONTAINER_NAME=gluetun
QBIT_CONTAINER_NAME=qbittorrent
VPN_UI_CONTAINER_NAME=gluetun-webui
MANAGE_CONTAINER_NAME=qbit_manage
NETWORK_NAME=media-vpn
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
